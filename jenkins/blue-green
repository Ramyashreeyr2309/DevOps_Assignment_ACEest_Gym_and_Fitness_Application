        stage('Deploy GREEN (Blue-Green)') {
    steps {
        bat """
            echo Updating GREEN deployment with new image...

            kubectl set image deployment/fitness-app-green fitness-container=%IMAGE_NAME%:%IMAGE_TAG%

            IF %ERRORLEVEL% NEQ 0 (
                echo GREEN deployment not found, creating it...
                kubectl apply -f k8s\\blue_green\\green.yaml
            )

            echo Waiting for GREEN rollout...
            kubectl rollout status deployment/fitness-app-green
        """
    }
}
stage('Approval before switching traffic') {
    steps {
        input message: 'Switch traffic to GREEN?', ok: 'Deploy'
    }
}

stage('Switch Traffic (Blue → Green)') {
    steps {
        bat """
            echo Switching traffic to GREEN...

            kubectl patch service fitness-service -p "{\\"spec\\":{\\"selector\\":{\\"app\\":\\"fitness\\",\\"version\\":\\"green\\"}}}"
        """
    }
}
stage('Rollback (if needed)') {
    when {
        expression { return false } // change to true if testing rollback
    }
    steps {
        bat """
            echo Rolling back to BLUE...

            kubectl patch service fitness-service -p "{\\"spec\\":{\\"selector\\":{\\"app\\":\\"fitness\\",\\"version\\":\\"blue\\"}}}"
        """
    }
}

        stage('Verify Deployment') {
            steps {
                bat """
                    kubectl get pods
                    kubectl get services
                """
            }
        }
    }
}